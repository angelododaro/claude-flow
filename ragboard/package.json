{
  "name": "ragboard",
  "version": "0.1.0",
  "private": true,
  "description": "Visual board-style AI interface with RAG capabilities",
  "author": "RAGBOARD Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter web prisma:generate",
    "prisma:migrate": "pnpm --filter web prisma:migrate",
    "prisma:studio": "pnpm --filter web prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}