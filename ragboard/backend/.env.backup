# Backend Environment Variables

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/ragboard
DATABASE_TEST_URL=postgresql://postgres:password@localhost:5432/ragboard_test

# Redis Configuration  
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-too
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application Settings
APP_NAME=RAGBOARD
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# API Settings
API_V1_PREFIX=/api/v1

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100MB

# AI/ML Configuration
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_AI_MODEL=gpt-3.5-turbo

# Embedding Configuration
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=ragboard_documents

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_ATTEMPTS=5
WS_MAX_CONNECTIONS=1000

# Background Processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Development Settings
DEBUG=true
TESTING=false

# Production Settings (uncomment for production)
# ENVIRONMENT=production
# DEBUG=false
# RELOAD=false
# SECRET_KEY=generate-a-strong-secret-key
# JWT_SECRET_KEY=generate-a-strong-jwt-secret
# DATABASE_URL=postgresql://user:password@prod-host:5432/ragboard
# REDIS_URL=redis://prod-host:6379/0